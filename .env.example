# ORCA Environment Configuration

# Primary LLM Configuration
LLM_PROVIDER=offline         # options: "offline", "openai", "gemini", "anthropic", "groq"
LLM_MODEL=gpt-4o-mini        # model identifier if provider enabled
LLM_API_KEY=                 # API key for the chosen LLM provider

# Backward-compatible alias
ORCA_LLM_PROVIDER=offline
ORCA_LLM_MODEL=gpt-4o-mini

# Marine Data API Configuration
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# Runtime Settings
ORCA_ENV=development
ORCA_DEBUG=true
